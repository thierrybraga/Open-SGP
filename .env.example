# ==================================================================
# Open-SGP - exemplo de ambiente
# Copie para .env ou execute: python deploy.py init-env
# Nunca commite .env com valores reais.
# ==================================================================

# Ambiente: development, staging, production, testing
ENVIRONMENT=development
TZ=America/Sao_Paulo

# ==================================================================
# Segurança
# ==================================================================
# Produção exige chave forte com 32+ caracteres.
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_SECRET_KEY

# Fernet key para criptografar credenciais armazenadas.
# Gere com: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

JWT_EXPIRATION_MINUTES=1440
TOKEN_BLACKLIST_TTL=86400

# ==================================================================
# Bootstrap e migrações
# ==================================================================
AUTO_CREATE_TABLES=false
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
PUBLIC_REGISTRATION_ENABLED=false

# ==================================================================
# Banco de dados e Redis
# ==================================================================
POSTGRES_DB=isp_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/isp_erp
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0

REDIS_URL=redis://localhost:6379/0

# ==================================================================
# HTTP / CORS / portas do deploy local
# ==================================================================
API_PORT=8000
ADMIN_PORT=5000
API_PUBLIC_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080
API_WORKERS=2
ADMIN_WORKERS=2

# ==================================================================
# SMTP
# ==================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Open-SGP

# ==================================================================
# SMS
# ==================================================================
SMS_GATEWAY_URL=
SMS_API_KEY=

# ==================================================================
# WhatsApp
# WHATSAPP_PROVIDER: gateway, twilio, gupshup, zenvia
# ==================================================================
WHATSAPP_PROVIDER=gateway
WHATSAPP_GATEWAY_URL=
WHATSAPP_API_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

GUPSHUP_API_URL=
GUPSHUP_API_KEY=

ZENVIA_API_URL=
ZENVIA_API_TOKEN=

# ==================================================================
# Fiscal / SEFAZ
# SEFAZ_ENVIRONMENT: homologacao ou producao
# ==================================================================
A1_CERT_PFX_PATH=
A1_CERT_PASSWORD=
SEFAZ_ENVIRONMENT=homologacao
SEFAZ_UF=SP

# ==================================================================
# Pagamentos
# ==================================================================
PAYMENT_GATEWAY_PROVIDER=asaas
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_ENVIRONMENT=sandbox

# ==================================================================
# Rede / RADIUS / Zabbix
# ==================================================================
MIKROTIK_DEFAULT_USERNAME=admin
MIKROTIK_DEFAULT_PASSWORD=

RADIUS_SERVER_HOST=localhost
RADIUS_SERVER_PORT=1812
RADIUS_SECRET=testing123

ZABBIX_WEB_PORT=8081
ZABBIX_SERVER_PORT=10051
ZBX_STARTPOLLERS=5

# ==================================================================
# Storage / backup
# ==================================================================
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=open-sgp
STORAGE_S3_REGION=us-east-1

BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30

# ==================================================================
# Observabilidade
# ==================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ==================================================================
# Rate limiting e features
# ==================================================================
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_API=1000/hour

FEATURE_2FA_ENABLED=false
FEATURE_2FA_REQUIRED_ADMIN=false
FEATURE_FISCAL_ENABLED=true
FEATURE_SMS_ENABLED=true
FEATURE_WHATSAPP_ENABLED=true
FEATURE_PAYMENT_GATEWAY_ENABLED=true
FEATURE_BACKUP_ENABLED=true
